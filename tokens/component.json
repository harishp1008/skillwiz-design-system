{
  "$description": "Component tokens: component-specific values. Reference semantic tokens (primitive where no semantic role exists). Raw values only where the style guide specifies a component-specific measurement.",
  "button": {
    "height": {
      "$value": "36px",
      "$source": "documented",
      "$description": "Style guide: button height."
    },
    "radius": {
      "$value": "{radius.control}",
      "$description": "Style guide: button corner radius."
    },
    "font-size": {
      "$value": "{type.button.size}"
    },
    "font-weight": {
      "$value": "{type.button.weight}",
      "$description": "Button label weight."
    },
    "icon-size": {
      "$value": "16px",
      "$source": "documented",
      "$description": "Style guide icon button note: line icon size (stroke follows currentColor)."
    },
    "icon-gap": {
      "$value": "6px",
      "$source": "documented",
      "$description": "Style guide icon button note: gap between icon and label. Not on the spacing scale."
    },
    "padding-icon-side": {
      "$value": "{space.control-padding-icon-side}",
      "$description": "Style guide icon button note: padding on the icon side."
    },
    "padding-text-side": {
      "$value": "{space.control-padding-text-side}",
      "$description": "Style guide icon button note: padding on the text side."
    },
    "focus-ring-width": {
      "$value": "3px",
      "$source": "documented",
      "$description": "Style guide: focus ring width."
    },
    "focus-ring-color": {
      "$value": "{color.focus.ring}"
    },
    "pressed-scale": {
      "$value": "0.96",
      "$source": "documented",
      "$description": "Style guide: scale applied while pressed."
    },
    "pressed-duration": {
      "$value": "150ms",
      "$source": "documented",
      "$description": "Style guide: press animation duration."
    },
    "pressed-easing": {
      "$value": "ease-out",
      "$source": "documented",
      "$description": "Style guide: ease-out."
    },
    "primary": {
      "bg": {
        "$value": "{color.action.default}"
      },
      "text": {
        "$value": "{color.text.on-action}"
      },
      "border": {
        "$value": "{color.action.default}"
      },
      "bg-hover": {
        "$value": "{color.action.hover}",
        "$description": "Style guide hover state fill for the primary button."
      },
      "border-hover": {
        "$value": "{color.action.hover}"
      }
    },
    "secondary": {
      "bg": {
        "$value": "{color.surface.default}"
      },
      "text": {
        "$value": "{color.text.body}"
      },
      "border": {
        "$value": "{color.border.control}"
      },
      "bg-hover": {
        "$value": "{color.surface.page}",
        "$description": "Style guide hover state fill for the secondary button."
      }
    },
    "outline": {
      "bg": {
        "$value": "{color.surface.default}"
      },
      "text": {
        "$value": "{color.action.text}"
      },
      "border": {
        "$value": "{color.action.default}"
      }
    },
    "danger": {
      "bg": {
        "$value": "{color.danger.solid}"
