      "text": {
        "$value": "{color.text.on-action}"
      },
      "border": {
        "$value": "{color.danger.solid}"
      }
    },
    "disabled": {
      "bg": {
        "$value": "{color.surface.default}"
      },
      "text": {
        "$value": "{color.text.disabled}"
      },
      "border": {
        "$value": "{color.border.disabled}"
      },
      "border-style": {
        "$value": "dashed",
        "$source": "documented",
        "$description": "Style guide: disabled buttons use a dashed border."
      }
    }
  },
