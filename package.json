{
  "name": "@skillwiz/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "tokens": "node --disable-warning=ExperimentalWarning scripts/build-tokens.ts",
    "tokens:check": "node --disable-warning=ExperimentalWarning scripts/build-tokens.ts --check",
    "dev": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens && vite build && tsc -p tsconfig.build.json",
    "check": "npm run tokens:check && npm run test:tokens && npm run typecheck && npm run build",
    "test:tokens": "node --disable-warning=ExperimentalWarning --test scripts/build-tokens.test.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
